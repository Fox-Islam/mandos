# Mandos secrets. This file is the only place a token belongs; the config records
# nothing but the name of the variable that holds one.
#
# Every name below is a variable some provider can be pointed at. An empty value
# counts as unset, so a name you never fill in costs nothing. Fill in the judge's
# key and whichever providers your council uses.
#
# Written at 0600. Never commit it.

# The judge. TYPESAFE_API_KEY reaches Jev directly; OPENROUTER_API_KEY reaches it
# through OpenRouter, and doubles as a panel key.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Panel providers, by the conventional name each one documents.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
OPENCODE_API_KEY=
