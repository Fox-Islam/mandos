Screen {
    background: #0B0B0B;
    color: #F2914B;
}

#dashboard {
    layout: vertical;
    width: 1fr;
    height: 1fr;
    background: #0B0B0B;
    padding: 0 1;
    border: double #F2914B;
    border-title-align: center;
    border-title-color: #F2914B;
    border-title-style: bold;
    border-subtitle-align: center;
    border-subtitle-color: #A16337;
}

#dashboard-body {
    layout: horizontal;
    height: 1fr;
}

#dashboard-nav {
    width: 28;
    min-width: 22;
    height: 1fr;
    background: #0B0B0B;
    border: round #5C3920;
    border-title-align: left;
    border-title-color: #D67D3D;
    padding: 0 1;
}

#dashboard-main {
    width: 1fr;
    height: 1fr;
    border: round #5C3920;
    border-title-align: left;
    border-title-color: #D67D3D;
    padding: 0 1;
}

.brand {
    background: #0B0B0B;
    color: #F2914B;
    text-style: bold;
    height: 10;
    padding: 0 1;
    border: round #F2914B;
}

#brand {
    height: auto;
    border: none;
    padding: 0 1;
}

.meta {
    color: #D67D3D;
    height: 1;
    padding: 0 1;
}

#harness {
    /* Auto: the block is a heading plus one row per harness, and the catalog status
       appends another. A fixed height clipped everything after the first harness. */
    height: auto;
}

#roster-title {
    color: #F2914B;
    text-style: bold;
    height: 1;
}

#roster {
    height: 1fr;
    min-height: 5;
    background: #0B0B0B;
    color: #F2914B;
}

#roster > .datatable--header {
    background: #0B0B0B;
    color: #D67D3D;
    text-style: bold;
}

#roster > .datatable--cursor {
    background: #F2914B;
    color: #0B0B0B;
}

.status {
    color: #F2914B;
    min-height: 3;
    max-height: 6;
}

#actions-title {
    color: #F2914B;
    text-style: bold;
    height: 1;
}

#action-menu {
    height: auto;
    min-height: 5;
    background: #0B0B0B;
    color: #F2914B;
    margin: 1 0;
}

#action-menu > .option-list--option-highlighted {
    background: #F2914B;
    color: #0B0B0B;
}

#member-form {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

.field-label {
    color: #D67D3D;
    height: 1;
    width: auto;
}

.form-row {
    height: auto;
}

#preset {
    width: 2fr;
}

#preset-search {
    width: 2fr;
}

#model-select {
    width: 2fr;
}

#model-input {
    width: 2fr;
}

#fetch-models,
#test-connection,
#save-member,
#cancel {
    width: auto;
}

#form-status {
    min-height: 2;
}

#delete-member,
#defaults-form,
#roles-form,
#harness-form {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

#delete-status,
#defaults-status,
#roles-status,
#harness-status {
    min-height: 2;
}

/* ---------------------------------------------------------------------------
   Sub-screen chrome and widget theming.

   The dashboard was styled and nothing else was, so opening a form dropped the
   double orange frame and fell back to Textual's stock palette: blue focus
   borders, a blue scrollbar and white-on-blue selects against an orange theme.
   These rules give every screen the same frame and put the widgets in palette.
   --------------------------------------------------------------------------- */

Screen {
    scrollbar-background: #0B0B0B;
    scrollbar-background-hover: #0B0B0B;
    scrollbar-background-active: #0B0B0B;
    scrollbar-color: #5C3920;
    scrollbar-color-hover: #D67D3D;
    scrollbar-color-active: #F2914B;
    scrollbar-size-vertical: 1;
}



/* Every editing screen is framed the way the dashboard frames itself, with the
   screen name in the border. This replaced a separate three-row title bar, so it
   costs a row less than before. The scrolling widget also owns its scrollbar, which
   stayed Textual blue while these rules lived on Screen. */
#member-form,
#judge-form,
#defaults-form,
#roles-form,
#harness-form,
#delete-member {
    border: double #F2914B;
    border-title-align: center;
    border-title-color: #F2914B;
    border-title-style: bold;
    background: #0B0B0B;
    scrollbar-background: #0B0B0B;
    scrollbar-background-hover: #0B0B0B;
    scrollbar-background-active: #0B0B0B;
    scrollbar-color: #5C3920;
    scrollbar-color-hover: #D67D3D;
    scrollbar-color-active: #F2914B;
    scrollbar-size-vertical: 1;
}

Input {
    background: #141210;
    color: #E8E2DA;
    border: round #5C3920;
}
Input:focus {
    border: round #F2914B;
}
Input.-invalid {
    border: round #C4462F;
}

Select > SelectCurrent {
    background: #141210;
    color: #E8E2DA;
    border: round #5C3920;
}
Select:focus > SelectCurrent {
    border: round #F2914B;
}
Select > SelectOverlay {
    background: #141210;
    color: #E8E2DA;
    border: round #5C3920;
}
Select > SelectOverlay > .option-list--option-highlighted {
    background: #5C3920;
    color: #F2914B;
    text-style: bold;
}

Button {
    background: #141210;
    color: #E8E2DA;
    border: round #5C3920;
}
Button:focus {
    border: round #F2914B;
    text-style: bold;
}
/* Every button keeps the same outlined shape. A filled primary sat beside an
   outlined Cancel looking like a different kind of control; emphasis is carried by
   colour and weight instead. */
Button.-primary {
    background: #141210;
    color: #F2914B;
    border: round #F2914B;
    text-style: bold;
}
Button.-error {
    background: #141210;
    color: #C4462F;
    border: round #C4462F;
    text-style: bold;
}
Button.-primary:focus,
Button.-error:focus {
    text-style: bold reverse;
}

/* No border: a tall one puts two blank rows around every entry, where the action
   menu marks its focused row and stays compact. */
Checkbox, RadioButton {
    background: #0B0B0B;
    color: #E8E2DA;
    border: none;
    padding: 0 1;
}
Checkbox:focus, RadioButton:focus {
    background: #5C3920;
}
/* Textual highlights the focused label with its own accent; unset it or the row
   turns bright blue in an orange terminal. */
Checkbox:focus > .toggle--label,
RadioButton:focus > .toggle--label {
    background: #5C3920;
    color: #F2914B;
    text-style: bold;
}
Checkbox > .toggle--button,
RadioButton > .toggle--button {
    background: #141210;
    color: #5C3920;
}
Checkbox.-on > .toggle--button,
RadioButton.-on > .toggle--button {
    background: #141210;
    color: #F2914B;
}

/* The roster is a DataTable and scrolls horizontally on a narrow terminal. */
#roster {
    scrollbar-background: #0B0B0B;
    scrollbar-background-hover: #0B0B0B;
    scrollbar-background-active: #0B0B0B;
    scrollbar-color: #5C3920;
    scrollbar-color-hover: #D67D3D;
    scrollbar-color-active: #F2914B;
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 1;
}
